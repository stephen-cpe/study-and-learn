# Study-and-Learn Environment Configuration
# Copy this file to `.env` and fill in your actual values.
# Never commit secrets or API keys to version control.

# ── Flask Core ──────────────────────────────────────────────────────────────
# Secret key for session signing and CSRF protection.
# Generate a strong random string for production.
SECRET_KEY=change-me-in-production

# ── Database ────────────────────────────────────────────────────────────────
# SQLAlchemy database URI — PostgreSQL ONLY.
# Format: postgresql+psycopg2://user:password@host:port/dbname
# The app will refuse to start if this does not begin with `postgresql`.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/study_and_learn

# ── AI / Ollama Configuration ───────────────────────────────────────────────
# Set to `true` to return deterministic mock responses (CI/testing mode).
AI_MOCK=false

# Backend selector: `local` or `cloud`.
# If `cloud`, ensure OLLAMA_CLOUD_API_KEY and OLLAMA_CLOUD_BASE_URL are set.
AI_BACKEND=local

# Ollama chat model — used by both local and cloud backends.
# The default below is a working placeholder; override it with any chat
# model available on your Ollama (local) or Ollama Cloud instance. Choose
# based on your hardware and quality needs (small CPU model for local dev,
# larger cloud model for production). See the Ollama model library for options.
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300

# Context window size (tokens) for local Ollama calls. Controls how much
# document text the model can process per call. Default 131072 (128K) works
# for all Ollama Cloud models. Increase for 256K/1M context models, or
# decrease for small local models with limited RAM.
OLLAMA_NUM_CTX=131072

# Number of document chunks to retrieve per RAG query. Each chunk is ~1000
# chars. Higher values give the model more document context but may dilute
# relevance. Default 20 (per-module); the processing route uses 40 for
# broader document understanding during summary/curriculum generation.
RAG_TOP_K=20

# Ollama Cloud settings (only needed when AI_BACKEND=cloud)
# Set OLLAMA_MODEL to a chat model available on your Ollama Cloud
# instance. The hardcoded fallback in config_defaults.py / ai_client_cloud.py
# is gemma4:cloud, so leaving OLLAMA_MODEL unset in cloud mode is
# safe — override it to use any other cloud chat model you prefer.
OLLAMA_CLOUD_API_KEY=your-ollama-cloud-api-key-here
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# ── CI / Testing ───────────────────────────────────────────────────────────
# Set to `true` in GitHub Actions to force ephemeral (in-memory) ChromaDB and mock AI.
CI=false

# ── Vector Store / ChromaDB ────────────────────────────────────────────────
# ChromaDB backend selector: `local` (default) or `cloud`.
# If unset or `local`, uses a local PersistentClient (./data/chroma_db).
# If `cloud`, uses Chroma Cloud via the credentials below. When cloud is
# requested but credentials are missing/empty/invalid or the connection
# fails, the app logs the error and reverts to the local PersistentClient.
# CI=true always overrides this to in-memory ChromaDB (tests stay isolated).
CHROMA_DB=local

# Chroma Cloud credentials (only required when CHROMA_DB=cloud).
# CHROMA_CLOUD_CONNECTION_STRING is the Chroma tenant ID.
# CHROMA_COLLECTION_NAME becomes the Chroma Cloud database name; the app's
# per-file collections (doc_<filehash>) live inside it.
CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_CONNECTION_STRING=
CHROMA_COLLECTION_NAME=study-and-learn-chromadb

# ── Session Storage ─────────────────────────────────────────────────────────
# Optional override for the Flask-Session filesystem cache directory.
# Defaults to data/flask_session if not set.
FLASK_SESSION_DIR=data/flask_session

# ── OCR / Vision Models ─────────────────────────────────────────────────────
# Local OCR model (no cloud variant available — must be pulled locally)
OLLAMA_OCR_MODEL=glm-ocr

# Vision-language model for figure descriptions (cloud only — 320B MoE too large for local)
# GLM-5.3-Flash: natively multimodal (Text+Image), 1M context, flash pricing tier.
OLLAMA_VISION_MODEL=glm-5.3-flash:cloud

# Maximum seconds per page for OCR processing
OCR_TIMEOUT_PER_PAGE=120

# Maximum image dimension before resizing (preserves aspect ratio)
OCR_MAX_IMAGE_DIMENSION=2048

# Maximum file size in bytes to send for OCR processing. Images larger than
# this are silently skipped with a warning. Prevents OOM on very large scans.
OCR_MAX_FILE_BYTES=52428800

# Set to "true" to run all three OCR modes (text + table + figure) per page.
# Defaults to text-only OCR for speed. Only enable for image-heavy PDFs.
OCR_FULL=false

# Set to "true" to call Qwen3.5 cloud for per-page figure descriptions.
# Adds ~15-30 seconds per page. Disabled by default.
OCR_FIGURE_DESCRIPTION=false

# Poppler binary path (Windows only). Set this if you prefer not to modify
# your system PATH. Leave commented on macOS/Linux — pdftoppm is auto-detected.
#POPPLER_PATH=C:\Program Files\poppler\Library\bin