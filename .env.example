# Study-and-Learn Environment Configuration
# Copy this file to `.env` and fill in your actual values.
# Never commit secrets or API keys to version control.

# ── Flask Core ──────────────────────────────────────────────────────────────
# Secret key for session signing and CSRF protection.
# Generate a strong random string for production.
SECRET_KEY=change-me-in-production

# ── Database ────────────────────────────────────────────────────────────────
# SQLAlchemy database URI — PostgreSQL ONLY.
# Format: postgresql+psycopg2://user:password@host:port/dbname
# The app will refuse to start if this does not begin with `postgresql`.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/study_and_learn

# ── AI / Ollama Configuration ───────────────────────────────────────────────
# Set to `true` to return deterministic mock responses (CI/testing mode).
AI_MOCK=false

# Backend selector: `local` or `cloud`.
# If `cloud`, ensure OLLAMA_CLOUD_API_KEY and OLLAMA_CLOUD_BASE_URL are set.
AI_BACKEND=local

# Ollama chat model — used by both local and cloud backends.
# The default below is a working placeholder; override it with any chat
# model available on your Ollama (local) or Ollama Cloud instance. Choose
# based on your hardware and quality needs (small CPU model for local dev,
# larger cloud model for production). See the Ollama model library for options.
# With AI_BACKEND=cloud, change this to a cloud model (for example
# gemma4:31b-cloud) or remove the line to use the cloud default from
# config_defaults.py. The value below is a local model.
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=300

# Context window (tokens) used to size local Ollama calls and the RAG
# budget on both backends. Set this to your model's actual window; in
# cloud mode it is not sent to the API. Defaults live in
# config_defaults.py.
OLLAMA_NUM_CTX=131072

# ── JSON generation resilience ──────────────────────────────────────────
# Sampling temperature for structured JSON generation. Lower values make
# lesson/quiz JSON more stable; the historical implicit default (~0.8)
# caused schema drift and truncation. Range 0.0–0.5 recommended.
OLLAMA_TEMPERATURE=0.25

# Hard bound on generated tokens per call. Prevents a runaway generation
# from truncating mid-JSON at the context limit (local) or exhausting a
# long response (cloud max_tokens). Raise for very long-form outputs.
OLLAMA_NUM_PREDICT=8192

# Optional Ollama Cloud reasoning effort. Leave empty to omit the field and
# preserve current model behaviour. WARNING: setting any value turns thinking
# ON for models like gemma4:31b-cloud and can consume the entire output cap.
#OLLAMA_CHAT_REASONING_EFFORT=
#OLLAMA_VISION_REASONING_EFFORT=

# Extra repair attempts after an unparseable JSON response (0 disables).
# The generators re-prompt with "return ONLY valid JSON" before degrading
# to placeholder content. Default 2 (1 initial + 2 repairs).
LLM_JSON_REPAIR_ATTEMPTS=2

# Per-module RAG retrieval fraction of the context budget. Lower values
# shorten the lesson prompt (higher valid-JSON rate); the digest is also
# truncated per module. Default 0.25.
MODULE_CONTEXT_FRACTION=0.25
MODULE_DIGEST_CHARS=24000

# Maximum number of chunks merged into the retrieved context, and the
# default per-collection query depth. The processing route queries 40
# candidates per collection but still caps the merged set at RAG_TOP_K.
# Each chunk is ~1000 chars; higher values give more context subject to
# the character budget.
RAG_TOP_K=20

# Ollama Cloud settings (only needed when AI_BACKEND=cloud)
# Set OLLAMA_MODEL to a chat model available on your Ollama Cloud
# instance. The fallback in config_defaults.py / ai_client_cloud.py is
# used when OLLAMA_MODEL is unset, so leaving it out in cloud mode is
# safe — override it to use any other cloud chat model you prefer.
OLLAMA_CLOUD_API_KEY=your-ollama-cloud-api-key-here
OLLAMA_CLOUD_BASE_URL=https://ollama.com

# ── External web suggestions (opt-in, fail-closed) ─────────────────────
# Fires ONLY when internal doc topics are exhausted AND the topic
# classifies as public (Physics/Math/CS/Engineering). Proprietary docs
# (HR, company-internal) never touch the web. Reuses the Ollama Cloud
# key above for /api/web_search + /api/web_fetch.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=30
WEB_SEARCH_SYNTH_MODEL=gpt-oss:20b-cloud

# ── CI / Testing ───────────────────────────────────────────────────────────
# Set to `true` in GitHub Actions to force ephemeral (in-memory) ChromaDB and mock AI.
CI=false

# ── Vector Store / ChromaDB ────────────────────────────────────────────────
# ChromaDB backend selector: `local` (default) or `cloud`.
# If unset or `local`, uses a local PersistentClient (./data/chroma_db).
# If `cloud`, uses Chroma Cloud via the credentials below. When cloud is
# requested but credentials are missing/empty/invalid or the connection
# fails, the app logs the error and reverts to the local PersistentClient.
# CI=true always overrides this to in-memory ChromaDB (tests stay isolated).
CHROMA_DB=local

# Chroma Cloud credentials (only required when CHROMA_DB=cloud).
# CHROMA_CLOUD_CONNECTION_STRING is the Chroma tenant ID.
# CHROMA_COLLECTION_NAME becomes the Chroma Cloud database name; the app's
# per-file collections (doc_<filehash>) live inside it.
CHROMA_CLOUD_API_KEY=
CHROMA_CLOUD_CONNECTION_STRING=
CHROMA_COLLECTION_NAME=study-and-learn-chromadb

# ── OCR / Vision ─────────────────────────────────────────────────────────
# Consolidated onto a single natively multimodal cloud model (Text+Image);
# defaults live in config_defaults.py. Cloud-served by default: with
# AI_BACKEND=local, set a locally available vision model or set
# OCR_FULL=false. Direct image uploads still need a vision model.
# NOTE: the old local-only `OLLAMA_OCR_MODEL=glm-ocr` is removed — any
# leftover value in your .env is ignored.
OLLAMA_VISION_MODEL=glm-5.3-flash:cloud

# Maximum image dimension before resizing (preserves aspect ratio)
OCR_MAX_IMAGE_DIMENSION=2048

# Maximum file size in bytes to send for OCR processing. Images larger than
# this are silently skipped with a warning. Prevents OOM on very large scans.
OCR_MAX_FILE_BYTES=52428800

# Vision OCR is ON by default. Text-layer PDFs skip rendering + LLM calls
# automatically (smart gate: only scanned/image-heavy PDFs trigger vision).
# Set to "false" to skip the full text+table+figure passes for PDFs, DOCX
# and PPTX. Direct image uploads still make one text-only vision call.
OCR_FULL=true

# Figure descriptions via the same vision model. ON by default.
# Adds ~15-30 seconds per vision-triggered page.
OCR_FIGURE_DESCRIPTION=true

# Poppler binary path (Windows only). Set this if you prefer not to modify
# your system PATH. Leave commented on macOS/Linux — pdftoppm is auto-detected.
#POPPLER_PATH=C:\Program Files\poppler\Library\bin